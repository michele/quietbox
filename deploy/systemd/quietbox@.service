# quietbox: one always-on daemon (`quietbox run`) per mailbox account.
# The instance name is the account: `systemctl enable --now quietbox@fastmail` runs
#   /usr/local/bin/quietbox --config /etc/quietbox/fastmail.toml run
# Install and set-up steps: docs/SYSTEMD.md.
[Unit]
Description=quietbox mail triage (%i)
Documentation=https://github.com/michele/quietbox/blob/main/docs/SYSTEMD.md
Wants=network-online.target
After=network-online.target
# Stay down until `quietbox init` has created the database (docs/SYSTEMD.md, "First run").
# The database path must match [state] path in /etc/quietbox/%i.toml.
ConditionPathExists=/var/lib/quietbox/%i.db
# A refusal (the server cannot MOVE, nothing learned yet) ends `run`: do not restart forever.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=quietbox
Group=quietbox
ExecStart=/usr/local/bin/quietbox --config /etc/quietbox/%i.toml run
Restart=on-failure
RestartSec=30s
# SIGTERM ends `run` cleanly: it stops between messages.
TimeoutStopSec=30s

# State: /var/lib/quietbox, created and owned by the quietbox user. A static user,
# not DynamicUser, so that `sudo -u quietbox quietbox ... undo` (same user, same
# files) works next to the daemon.
StateDirectory=quietbox
StateDirectoryMode=0700
UMask=0077

# Hardening. quietbox only talks to your IMAP server and writes its own database.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Go does not size its heap to a cgroup limit: keep it under MemoryMax.
Environment=GOMEMLIMIT=400MiB
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
