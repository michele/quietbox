# Copy to .env next to docker-compose.yml (`cp .env.example .env`). No secrets here.

# uid/gid the container runs as. Use the owner of secrets/imap_password and data/
# on the host: run `id` as that user on the NAS (Synology users often start at 1026).
PUID=65532
PGID=65532

# Time zone for log timestamps and duration math (an IANA name such as
# Europe/Rome or America/New_York).
TZ=UTC

# Image to run. A locally built image (make docker-build) is quietbox:local.
QUIETBOX_IMAGE=ghcr.io/michele/quietbox:latest
